<controls:FancyWindow xmlns="https://spacestation14.io"
                      xmlns:controls="clr-namespace:Content.Client.UserInterface.Controls"
                      Title="{Loc 'plant-analyzer-window-title'}"
                      MinSize="420 480"
                      SetSize="460 600">
    <ScrollContainer VerticalExpand="True" HorizontalExpand="True" HScrollEnabled="False" Margin="8">
        <BoxContainer Orientation="Vertical" HorizontalExpand="True">
            <Label Name="TargetName" StyleClasses="LabelHeading" />
            <RichTextLabel Name="Report" HorizontalExpand="True" />
        </BoxContainer>
    </ScrollContainer>
</controls:FancyWindow>
