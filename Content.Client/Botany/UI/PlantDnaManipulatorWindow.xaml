<controls:FancyWindow xmlns="https://spacestation14.io"
                      xmlns:controls="clr-namespace:Content.Client.UserInterface.Controls"
                      Title="{Loc 'plant-dna-window-title'}"
                      MinSize="520 520"
                      SetSize="560 640">
    <BoxContainer Orientation="Vertical" Margin="8" VerticalExpand="True">
        <BoxContainer Orientation="Horizontal" HorizontalExpand="True">
            <Label Text="{Loc 'plant-dna-sample'}" StyleClasses="LabelKeyText" MinWidth="110" />
            <Label Name="SeedLabel" HorizontalExpand="True" ClipText="True" />
            <Button Name="EjectSeedButton" Text="{Loc 'plant-dna-eject'}" />
        </BoxContainer>
        <BoxContainer Orientation="Horizontal" HorizontalExpand="True" Margin="0 4 0 0">
            <Label Text="{Loc 'plant-dna-disk'}" StyleClasses="LabelKeyText" MinWidth="110" />
            <Label Name="DiskLabel" HorizontalExpand="True" ClipText="True" />
            <Button Name="EjectDiskButton" Text="{Loc 'plant-dna-eject'}" />
        </BoxContainer>
        <controls:Separator StyleClasses="LowDivider" Margin="0 6 0 6" />
        <ScrollContainer VerticalExpand="True" HScrollEnabled="False">
            <BoxContainer Name="GeneList" Orientation="Vertical" HorizontalExpand="True" />
        </ScrollContainer>
        <controls:Separator StyleClasses="LowDivider" Margin="0 6 0 6" />
        <Button Name="InsertButton" HorizontalExpand="True" />
    </BoxContainer>
</controls:FancyWindow>
