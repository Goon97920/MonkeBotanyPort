<controls:FancyWindow xmlns="https://spacestation14.io"
                      xmlns:controls="clr-namespace:Content.Client.UserInterface.Controls"
                      Title="{Loc 'plant-splicer-window-title'}"
                      MinSize="480 480"
                      SetSize="520 560">
    <BoxContainer Orientation="Vertical" Margin="8" VerticalExpand="True">
        <Label Text="{Loc 'plant-splicer-first-seed'}" StyleClasses="LabelKeyText" />
        <BoxContainer Orientation="Horizontal" HorizontalExpand="True">
            <Label Name="FirstSeedLabel" HorizontalExpand="True" ClipText="True" />
            <Button Name="EjectFirstButton" Text="{Loc 'plant-dna-eject'}" />
        </BoxContainer>
        <RichTextLabel Name="FirstSeedStats" />
        <Label Text="{Loc 'plant-splicer-second-seed'}" StyleClasses="LabelKeyText" Margin="0 8 0 0" />
        <BoxContainer Orientation="Horizontal" HorizontalExpand="True">
            <Label Name="SecondSeedLabel" HorizontalExpand="True" ClipText="True" />
            <Button Name="EjectSecondButton" Text="{Loc 'plant-dna-eject'}" />
        </BoxContainer>
        <RichTextLabel Name="SecondSeedStats" />
        <controls:Separator StyleClasses="LowDivider" Margin="0 6 0 6" />
        <BoxContainer Orientation="Horizontal" HorizontalExpand="True">
            <Label Text="{Loc 'plant-splicer-beaker'}" StyleClasses="LabelKeyText" HorizontalExpand="True" />
            <Button Name="EjectBeakerButton" Text="{Loc 'plant-dna-eject'}" />
        </BoxContainer>
        <ScrollContainer VerticalExpand="True" HScrollEnabled="False">
            <RichTextLabel Name="BeakerContents" HorizontalExpand="True" />
        </ScrollContainer>
        <RichTextLabel Name="DamageLabel" />
        <BoxContainer Orientation="Horizontal" HorizontalExpand="True" Margin="0 8 0 0">
            <Button Name="SpliceButton" Text="{Loc 'plant-splicer-splice'}" HorizontalExpand="True" />
            <controls:ConfirmButton Name="InfuseButton" Text="{Loc 'plant-splicer-infuse'}" ConfirmationText="{Loc 'plant-dna-confirm'}" HorizontalExpand="True" />
        </BoxContainer>
    </BoxContainer>
</controls:FancyWindow>
